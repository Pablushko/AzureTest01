{
	"name": "Clean File",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "BronzeCSV",
						"type": "DatasetReference"
					},
					"name": "Source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SilverCSV",
						"type": "DatasetReference"
					},
					"name": "Destination"
				}
			],
			"transformations": [
				{
					"name": "SelectCols"
				},
				{
					"name": "AddExecDate"
				},
				{
					"name": "filter1"
				},
				{
					"name": "DCPopulation"
				}
			],
			"scriptLines": [
				"source(output(",
				"          location_id as short,",
				"          region as string,",
				"          country as string,",
				"          population as string,",
				"          density as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Source",
				"Source select(mapColumn(",
				"          LocationId = location_id,",
				"          Region = region,",
				"          Country = country,",
				"          Population = population,",
				"          Density = density",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectCols",
				"SelectCols derive(ExecutionDate = currentDate()) ~> AddExecDate",
				"AddExecDate filter(Density > 10) ~> filter1",
				"filter1 derive(Population = toInteger(replace(Population, ',', ''))) ~> DCPopulation",
				"DCPopulation sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Destination"
			]
		}
	}
}